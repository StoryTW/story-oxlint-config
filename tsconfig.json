{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
